# Copy these values into an untracked .env.local file for local development.
# Use the Supabase Project URL and publishable/anon client key from Project Settings > API.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Never put a service_role key, secret key, or other privileged credential in VITE_* variables.
